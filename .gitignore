__pycache__/
*.pyc
.pytest_cache/
.venv/

# Packaging artifacts. `pip install -e .` writes taskbound.egg-info in place;
# it holds no importable file, so it does not make a run's `git_dirty` true,
# but it is not source either.
*.egg-info/
build/
dist/

# Raw run results only. Anchored, so it does not swallow a host workspace that
# happens to contain a directory called `results` — project_b's does.
/results/
/test-results/
/test-results-v2/

# Pilot *schedules* are frozen artifacts and are committed; pilot *results* are
# raw runs and are not, for the same reason /results/ is ignored. A pilot's runs
# are never pooled with the sweep they precede (plan §11.2).
/pilot/*/

# Release canaries and payload markers are generated per release and never
# committed (plan §12). Nothing under here belongs in the repository.
canaries/
*.canary
